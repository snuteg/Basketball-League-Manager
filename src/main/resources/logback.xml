<configuration>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/league.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/league.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%date{yyyy-MM-dd HH:mm:ss} %-5level [%logger{28}] %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    <!-- Logging to a file keeps the interactive console clean. -->
    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
